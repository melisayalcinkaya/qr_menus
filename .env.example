# Kopyalayıp .env olarak kaydedin. .env dosyası git'e eklenmez.
DJANGO_DEBUG=true
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# QR kodlarının yönlendireceği müşteri menüsü adresi
PUBLIC_MENU_BASE_URL=http://localhost:5173
